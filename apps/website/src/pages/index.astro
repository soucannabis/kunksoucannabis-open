---
import "../styles/home.css";
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Sistema open source para associações de cannabis medicinal — documentação, instalação e apps."
    />
    <title>Kunk — Sistema open source para associações</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header is-over-hero" id="header">
      <div class="header-inner">
        <a class="brand" href="/">Kunk</a>
        <nav class="nav" aria-label="Principal">
          <a href="/">Início</a>
          <a href="/introducao/o-que-e/">Documentação</a>
          <a href="/apps/">Apps</a>
          <a href="/api/">API</a>
          <a
            href="https://github.com/soucannabis/kunksoucannabis-open"
            target="_blank"
            rel="noreferrer">GitHub</a
          >
        </nav>
        <a class="btn-install" href="/instalacao/setup-local/">Instalar</a>
        <button class="menu-toggle" type="button" aria-label="Abrir menu" id="menuOpen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      </div>
    </header>

    <div class="drawer" id="drawer" hidden>
      <div class="drawer-panel">
        <button class="drawer-close" type="button" id="menuClose">Fechar</button>
        <a href="/">Início</a>
        <a href="/introducao/o-que-e/">Documentação</a>
        <a href="/apps/">Apps</a>
        <a href="/api/">API</a>
        <a href="/instalacao/setup-local/">Instalar</a>
        <a
          href="https://github.com/soucannabis/kunksoucannabis-open"
          target="_blank"
          rel="noreferrer">GitHub</a
        >
      </div>
    </div>

    <main id="topo">
      <section class="hero" aria-label="Apresentação">
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="hero-inner">
          <h1 class="hero-brand">Kunk</h1>
          <p class="hero-lead">Sistema open source para associações de cannabis medicinal</p>
          <p class="hero-copy">
            Um produto, uma API e um banco por instância — cadastramento, operação, administração e
            assinatura de termos em apps claros.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/introducao/o-que-e/">Documentação</a>
            <a
              class="btn btn-ghost"
              href="https://github.com/soucannabis/kunksoucannabis-open"
              target="_blank"
              rel="noreferrer">Ver no GitHub</a
            >
            <button class="btn btn-demo" type="button" id="demoOpen">
              Acessar demonstração
            </button>
          </div>
        </div>
      </section>

      <div
        class="demo-modal"
        id="demoModal"
        hidden
        role="dialog"
        aria-modal="true"
        aria-labelledby="demoModalTitle"
      >
        <div class="demo-modal-backdrop" data-demo-close></div>
        <div class="demo-modal-panel">
          <button class="demo-modal-close" type="button" data-demo-close aria-label="Fechar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
          <h2 id="demoModalTitle">Acessar demonstração</h2>
          <div class="demo-modal-form-view" id="demoFormView">
            <p class="demo-modal-lead">
              Defina os dados para acessar o sistema de demonstração.
            </p>
            <form class="demo-form" id="demoForm" novalidate>
            <label class="demo-field">
              <span>Nome completo</span>
              <input
                type="text"
                name="nomeCompleto"
                autocomplete="name"
                required
                aria-required="true"
              />
              <span class="demo-field-error" data-error-for="nomeCompleto"></span>
            </label>
            <label class="demo-field">
              <span>Email</span>
              <input
                type="email"
                name="email"
                autocomplete="email"
                required
                aria-required="true"
              />
              <span class="demo-field-error" data-error-for="email"></span>
            </label>
            <label class="demo-field">
              <span>Senha</span>
              <div class="demo-password">
                <input
                  type="password"
                  name="senha"
                  id="demoSenha"
                  autocomplete="new-password"
                  required
                  aria-required="true"
                  minlength="8"
                />
                <button
                  class="demo-password-toggle"
                  type="button"
                  data-toggle-password="demoSenha"
                  aria-label="Mostrar senha"
                >
                  <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
                    <path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a21.77 21.77 0 0 1 5.06-5.94"></path>
                    <path d="M9.9 4.24A10.94 10.94 0 0 1 12 5c7 0 11 7 11 7a21.8 21.8 0 0 1-2.16 3.19"></path>
                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                    <path d="M1 1l22 22"></path>
                  </svg>
                </button>
              </div>
              <span class="demo-field-hint"
                >Mínimo 8 caracteres, com 1 letra maiúscula e 1 caractere especial.</span
              >
              <span class="demo-field-error" data-error-for="senha"></span>
            </label>
            <label class="demo-field">
              <span>Confirmar senha</span>
              <div class="demo-password">
                <input
                  type="password"
                  name="senhaConfirmacao"
                  id="demoSenhaConfirmacao"
                  autocomplete="new-password"
                  required
                  aria-required="true"
                  minlength="8"
                />
                <button
                  class="demo-password-toggle"
                  type="button"
                  data-toggle-password="demoSenhaConfirmacao"
                  aria-label="Mostrar senha"
                >
                  <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden>
                    <path d="M17.94 17.94A10.94 10.94 0 0 1 12 19c-7 0-11-7-11-7a21.77 21.77 0 0 1 5.06-5.94"></path>
                    <path d="M9.9 4.24A10.94 10.94 0 0 1 12 5c7 0 11 7 11 7a21.8 21.8 0 0 1-2.16 3.19"></path>
                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"></path>
                    <path d="M1 1l22 22"></path>
                  </svg>
                </button>
              </div>
              <span class="demo-field-error" data-error-for="senhaConfirmacao"></span>
            </label>
            <button class="btn btn-primary demo-submit" type="submit" id="demoSubmit">
              <span class="demo-submit-label">Criar acesso</span>
              <span class="demo-submit-spinner" aria-hidden="true"></span>
            </button>
            <p class="demo-form-status" id="demoFormStatus" role="status" aria-live="polite"></p>
            </form>
          </div>
          <div class="demo-modal-success" id="demoSuccessView" hidden>
            <p class="demo-modal-lead demo-success-message">
              Seu cadastro de demonstração foi criado com sucesso, clique abaixo para acessar o
              Painel Administrativo, informe seu e-mail e senha definidos.
            </p>
            <a
              class="btn btn-primary demo-submit"
              id="demoAdminLogin"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
            >
              Acessar Painel Administrativo
            </a>
          </div>
        </div>
      </div>

      <section class="section" id="produto">
        <div class="section-inner product-grid">
          <div>
            <p class="eyebrow">O produto</p>
            <h2>Operação completa em uma instância</h2>
            <p class="section-lead">
              O Kunk unifica o fluxo da associação: do primeiro cadastro do associado à rotina diária
              da equipe, com configuração central no admin e termos digitais.
            </p>
            <a class="link-arrow" href="/introducao/principios/">Ler a documentação →</a>
          </div>
          <div class="surface-map" aria-label="Sistemas da instância">
            <div class="surface-row">
              <div>
                <strong>Cadastro de Associados</strong>
                <span>Adesão, documentos, dados clínicos e acompanhamento</span>
              </div>
            </div>
            <div class="surface-row">
              <div>
                <strong>Assinatura de termos</strong>
                <span>Documentos digitais e trilha de assinatura auditável</span>
              </div>
            </div>
            <div class="surface-row">
              <div>
                <strong>Kunk</strong>
                <span>Acolhimento, triagem, serviços, pedidos e relatórios</span>
              </div>
            </div>
            <div class="surface-row">
              <div>
                <strong>Área Admin</strong>
                <span>Configurações, profissionais, serviços e permissões</span>
              </div>
            </div>
            <div class="surface-row">
              <div>
                <strong>API</strong>
                <span>Dados, autenticação, regras de negócio e integrações</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section apps" id="apps">
        <div class="section-inner">
          <p class="eyebrow">Sistemas</p>
          <h2>Uma plataforma para toda a associação</h2>
          <p class="section-lead">
            Quatro aplicações atendem cada papel da associação, conectadas por uma API que centraliza
            dados, autenticação, regras de negócio e integrações.
          </p>
          <div class="apps-list">
            <article class="app-item">
              <h3>Cadastro de Associados</h3>
              <p>Jornada pública de adesão com dados pessoais e clínicos, envio de documentos, termos e acompanhamento do cadastro.</p>
              <a class="link-arrow" href="/frontend/cadastramento/">Documentação →</a>
            </article>
            <article class="app-item">
              <h3>Assinatura de termos</h3>
              <p>Cria, apresenta e registra assinaturas de termos e documentos, preservando uma trilha auditável para associados e equipe.</p>
              <a class="link-arrow" href="/frontend/doc-sign/">Documentação →</a>
            </article>
            <article class="app-item">
              <h3>Kunk</h3>
              <p>Painel interno para acolhimento, triagem, pedidos, pagamentos e relatórios.</p>
              <a class="link-arrow" href="/frontend/kunk/">Documentação →</a>
            </article>
            <article class="app-item">
              <h3>Área Admin</h3>
              <p>Configura a instância: serviços, profissionais, usuários, permissões, integrações e parâmetros operacionais.</p>
              <a class="link-arrow" href="/frontend/admin/">Documentação →</a>
            </article>
            <article class="app-item">
              <h3>API</h3>
              <p>Camada central que oferece autenticação, dados, regras de negócio, arquivos e integrações para todos os aplicativos.</p>
              <a class="link-arrow" href="/api/">Documentação →</a>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="para-quem">
        <div class="section-inner">
          <p class="eyebrow">Para quem</p>
          <h2>Feito para o dia a dia da associação</h2>
          <p class="section-lead">
            Papéis distintos no mesmo produto — sem fragmentar em sistemas paralelos.
          </p>
          <ol class="audience-list">
            <li>
              <span class="n">01</span>
              <div>
                <strong>Associados</strong>
                <span>Cadastro, termos e acompanhamento do vínculo com a associação.</span>
              </div>
            </li>
            <li>
              <span class="n">02</span>
              <div>
                <strong>Operadores</strong>
                <span>Acolhimento, triagem, serviços, pedidos e rotinas do painel Kunk.</span>
              </div>
            </li>
            <li>
              <span class="n">03</span>
              <div>
                <strong>Administradores</strong>
                <span>Configuração da instância, papéis, tipos e integrações.</span>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section class="section start" id="comecar">
        <div class="section-inner">
          <p class="eyebrow">Começar</p>
          <h2>Do repositório à instância</h2>
          <p class="section-lead">
            Três passos para subir o ambiente. A documentação completa cobre requisitos, variáveis e
            deploy.
          </p>
          <div class="steps">
            <div class="step">
              <p class="step-n">01</p>
              <h3>Clonar</h3>
              <p>Obtenha o monorepo e as dependências do workspace.</p>
            </div>
            <div class="step">
              <p class="step-n">02</p>
              <h3>Configurar</h3>
              <p>Defina banco, secrets e variáveis por app.</p>
            </div>
            <div class="step">
              <p class="step-n">03</p>
              <h3>Subir</h3>
              <p>API e frontends locais — ou o stack de deploy.</p>
            </div>
          </div>
          <a class="btn btn-primary" href="/instalacao/setup-local/">Abrir guia de instalação</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <p class="footer-brand">Kunk</p>
          <p class="footer-meta">Open source · SouCannabis</p>
        </div>
        <nav class="footer-links" aria-label="Rodapé">
          <a href="/introducao/o-que-e/">Documentação</a>
          <a href="/apps/">Apps</a>
          <a href="/instalacao/setup-local/">Instalação</a>
          <a
            href="https://github.com/soucannabis/kunksoucannabis-open"
            target="_blank"
            rel="noreferrer">GitHub</a
          >
        </nav>
      </div>
    </footer>

    <script is:inline>
      const header = document.getElementById("header");
      const hero = document.querySelector(".hero");
      const drawer = document.getElementById("drawer");

      function updateHeader() {
        const overHero = window.scrollY < hero.offsetHeight - 64;
        header.classList.toggle("is-over-hero", overHero);
        header.classList.toggle("is-scrolled", window.scrollY > 12);
      }

      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      const open = () => {
        drawer.hidden = false;
        drawer.classList.add("open");
        document.body.style.overflow = "hidden";
      };
      const close = () => {
        drawer.classList.remove("open");
        drawer.hidden = true;
        document.body.style.overflow = "";
      };

      document.getElementById("menuOpen").addEventListener("click", open);
      document.getElementById("menuClose").addEventListener("click", close);
      drawer.addEventListener("click", (e) => {
        if (e.target === drawer) close();
      });
      drawer.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));

      const DEMO_WEBHOOK =
        "https://n8n.soucannabis.ong.br/webhook/bb926182-a00c-4404-b0c9-4cb1fe63df58";
      const PASSWORD_RULE = /^(?=.*[A-Z])(?=.*[^A-Za-z0-9]).{8,}$/;

      const demoModal = document.getElementById("demoModal");
      const demoForm = document.getElementById("demoForm");
      const demoFormView = document.getElementById("demoFormView");
      const demoSuccessView = document.getElementById("demoSuccessView");
      const demoAdminLogin = document.getElementById("demoAdminLogin");
      const demoStatus = document.getElementById("demoFormStatus");
      const demoSubmit = document.getElementById("demoSubmit");
      const demoModalTitle = document.getElementById("demoModalTitle");
      let lastFocus = null;

      function setFieldError(name, message) {
        const el = demoForm.querySelector(`[data-error-for="${name}"]`);
        const input = demoForm.elements.namedItem(name);
        if (el) el.textContent = message || "";
        if (input && "setAttribute" in input) {
          input.setAttribute("aria-invalid", message ? "true" : "false");
        }
      }

      function clearErrors() {
        ["nomeCompleto", "email", "senha", "senhaConfirmacao"].forEach((name) =>
          setFieldError(name, "")
        );
        demoStatus.textContent = "";
        demoStatus.className = "demo-form-status";
      }

      function showDemoForm() {
        demoFormView.hidden = false;
        demoSuccessView.hidden = true;
        demoModalTitle.textContent = "Acessar demonstração";
        demoAdminLogin.href = "#";
      }

      function adminLoginHref(rawUrl) {
        try {
          const u = new URL(String(rawUrl || "").trim());
          if (u.pathname === "/" || u.pathname === "") u.pathname = "/login";
          return u.toString();
        } catch {
          return String(rawUrl || "").trim();
        }
      }

      function showDemoSuccess(adminUrl) {
        demoFormView.hidden = true;
        demoSuccessView.hidden = false;
        demoModalTitle.textContent = "Acesso criado";
        demoAdminLogin.href = adminLoginHref(adminUrl);
        demoAdminLogin.focus();
      }

      function setDemoSubmitting(busy) {
        demoSubmit.disabled = busy;
        demoSubmit.classList.toggle("is-loading", busy);
        demoSubmit.setAttribute("aria-busy", busy ? "true" : "false");
      }

      function openDemo() {
        lastFocus = document.activeElement;
        clearErrors();
        showDemoForm();
        demoModal.hidden = false;
        demoModal.classList.add("open");
        document.body.style.overflow = "hidden";
        const first = demoForm.querySelector("input");
        if (first) first.focus();
      }

      function closeDemo() {
        demoModal.classList.remove("open");
        demoModal.hidden = true;
        document.body.style.overflow = "";
        showDemoForm();
        demoForm.reset();
        if (lastFocus && typeof lastFocus.focus === "function") lastFocus.focus();
      }

      document.getElementById("demoOpen").addEventListener("click", openDemo);
      demoModal.querySelectorAll("[data-demo-close]").forEach((el) => {
        el.addEventListener("click", closeDemo);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !demoModal.hidden) closeDemo();
      });

      demoModal.querySelectorAll("[data-toggle-password]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const input = document.getElementById(btn.getAttribute("data-toggle-password"));
          if (!input) return;
          const show = input.type === "password";
          input.type = show ? "text" : "password";
          btn.setAttribute("aria-label", show ? "Ocultar senha" : "Mostrar senha");
          btn.querySelector(".icon-eye").hidden = show;
          btn.querySelector(".icon-eye-off").hidden = !show;
        });
      });

      function validateDemoForm() {
        clearErrors();
        const nomeCompleto = demoForm.nomeCompleto.value.trim();
        const email = demoForm.email.value.trim();
        const senha = demoForm.senha.value;
        const senhaConfirmacao = demoForm.senhaConfirmacao.value;
        let ok = true;

        if (!nomeCompleto) {
          setFieldError("nomeCompleto", "Informe o nome completo.");
          ok = false;
        }
        if (!email) {
          setFieldError("email", "Informe o email.");
          ok = false;
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          setFieldError("email", "Informe um email válido.");
          ok = false;
        }
        if (!senha) {
          setFieldError("senha", "Informe a senha.");
          ok = false;
        } else if (!PASSWORD_RULE.test(senha)) {
          setFieldError(
            "senha",
            "A senha precisa ter no mínimo 8 caracteres, 1 letra maiúscula e 1 caractere especial."
          );
          ok = false;
        }
        if (!senhaConfirmacao) {
          setFieldError("senhaConfirmacao", "Confirme a senha.");
          ok = false;
        } else if (senha && senha !== senhaConfirmacao) {
          setFieldError("senhaConfirmacao", "As senhas não coincidem.");
          ok = false;
        }

        return ok
          ? { nomeCompleto, email, senha }
          : null;
      }

      demoForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const data = validateDemoForm();
        if (!data) return;

        setDemoSubmitting(true);
        demoStatus.textContent = "";
        demoStatus.className = "demo-form-status";

        try {
          const res = await fetch(DEMO_WEBHOOK, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              nomeCompleto: data.nomeCompleto,
              email: data.email,
              senha: data.senha,
            }),
          });

          if (!res.ok) throw new Error(`HTTP ${res.status}`);

          const payload = await res.json().catch(() => ({}));
          const adminUrl = payload?.url || payload?.data?.url;
          if (!adminUrl) throw new Error("URL ausente na resposta");

          demoForm.reset();
          showDemoSuccess(adminUrl);
        } catch {
          demoStatus.className = "demo-form-status is-error";
          demoStatus.textContent =
            "Não foi possível enviar os dados. Tente novamente em instantes.";
        } finally {
          setDemoSubmitting(false);
        }
      });
    </script>
  </body>
</html>
