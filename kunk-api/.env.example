PORT=8056
DATABASE_URL=postgresql://user:pass@localhost:5432/kunk
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173,http://localhost:4255,http://localhost:4256,http://localhost:4257,http://localhost:4258
SESSION_MAX_HOURS=168
STORAGE_PATH=./storage
NODE_ENV=development
TERMS_DEV_BYPASS=false
# Master key for encrypting sensitive system_configs values (AES-256-GCM). Never put this in the DB.
CONFIG_ENCRYPT_KEY=
# URL pública da API (sem barra final). Usada nos callbacks OAuth (Google / Melhor Envio).
# Webhooks Pagar.me não funcionam com localhost — use túnel (ngrok) ou PAGARME_WEBHOOK_PUBLIC_URL.
# Se PUBLIC_API_URL for localhost, hooksSetup cai no túnel padrão de teste.
PUBLIC_API_URL=https://stallion-hot-weasel.ngrok-free.app
# PAGARME_WEBHOOK_PUBLIC_URL=https://stallion-hot-weasel.ngrok-free.app

MODULE_PAGARME_ENABLED=false
# PAGARME_SECRET_KEY= (ou PAGARME_TOKEN legado)
# PAGARME_PUBLIC_KEY=
# PAGARME_URL_API=https://api.pagar.me/core/v5
# PAGARME_WEBHOOK_USER=
# PAGARME_WEBHOOK_PASS=

MODULE_SOUCANNABIS_ORDERS_ENABLED=false
# SOUCANNABIS_ORDERS_BASE_URL=https://api.example.com
# SOUCANNABIS_ORDERS_CLIENT_ID=
# SOUCANNABIS_ORDERS_CLIENT_SECRET=
# SOUCANNABIS_ORDERS_TOKEN_URL=

MODULE_LOGGI_ENABLED=false
# Opcional: SISUs Loggi (csv) se store.freight.loggi.external_service_ids estiver vazio
# LOGGI_EXTERNAL_SERVICE_IDS=DLVR-DROF-DOOR-STAN-01
MODULE_MELHORENVIO_ENABLED=false
MODULE_GOOGLE_CALENDAR_ENABLED=false
MODULE_BEEVIRAL_ENABLED=false
MODULE_UTALK_ENABLED=false
MODULE_PIPEFY_ENABLED=false
MODULE_BRASILNFE_ENABLED=false
MODULE_SCP_ENABLED=false
MODULE_NIBO_ENABLED=false
MODULE_GEOAPIFY_ENABLED=false
MODULE_EMAIL_ENABLED=false
# CIAP-2: default on. Set false to force off (overrides admin). Admin toggle uses system_configs.
# MODULE_CIAP2_ENABLED=true
# Fallback da api_key se system_api_credentials estiver vazio
# MODULE_GOOGLE_CALENDAR_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=  (opcional; a API grava automaticamente a partir de PUBLIC_API_URL)
# GOOGLE_REFRESH_TOKEN=

# GEOAPIFY_API_KEY=

# SMTP (fallback se system_api_credentials service=email estiver vazio)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=SouCannabis

# URLs públicas dos apps (links em e-mails: reset senha, convites, termos)
KUNK_PUBLIC_URL=http://localhost:4255
ADMIN_PUBLIC_URL=http://localhost:4256
REGISTRATION_PUBLIC_URL=http://localhost:4257
DOC_SIGN_PUBLIC_URL=http://localhost:4258
