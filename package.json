{
  "name": "kunksoucannabis-open",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:registration": "npm run dev -w @kunk/registration",
    "dev:admin": "npm run dev -w @kunk/admin",
    "dev:kunk": "npm run dev -w @kunk/kunk",
    "test:api": "npm test --prefix kunk-api",
    "test:e2e": "npm run test:e2e -w @kunk/registration",
    "test:e2e:admin": "npm run test:e2e -w @kunk/admin",
    "test:kunk": "npm test -w @kunk/kunk",
    "test:e2e:kunk": "npm run test:e2e -w @kunk/kunk",
    "docker:registration": "docker compose -f apps/registration/docker-compose.yml up --build",
    "docker:admin": "docker compose -f apps/admin/docker-compose.yml up --build",
    "docker:kunk-app": "docker compose -f apps/kunk/docker-compose.yml up --build",
    "docker:kunk": "docker compose -f docker-compose.kunk.yml up --build"
  },
  "engines": {
    "node": ">=18"
  }
}
